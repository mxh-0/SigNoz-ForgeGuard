{
  "id": "signozforge-observer-overview",
  "uuid": "signozforge-observer-overview",
  "title": "SignozForge Observer - SRE Copilot Overview",
  "description": "Multi-agent pipeline health, LLM performance, and Copilot healing metrics",
  "tags": ["signozforge", "copilot", "agents", "llm"],
  "layout": [
    {"i": "tasks_submitted", "x": 0, "y": 0, "w": 3, "h": 2},
    {"i": "tasks_completed", "x": 3, "y": 0, "w": 3, "h": 2},
    {"i": "tasks_failed", "x": 6, "y": 0, "w": 3, "h": 2},
    {"i": "anomalies_detected", "x": 9, "y": 0, "w": 3, "h": 2},
    {"i": "llm_latency_avg", "x": 0, "y": 2, "w": 6, "h": 3},
    {"i": "llm_latency_p95", "x": 6, "y": 2, "w": 6, "h": 3},
    {"i": "healing_attempts_vs_success", "x": 0, "y": 5, "w": 6, "h": 3},
    {"i": "manual_mode_triggers", "x": 6, "y": 5, "w": 6, "h": 3},
    {"i": "agent_step_latency", "x": 0, "y": 8, "w": 12, "h": 3},
    {"i": "llm_calls_by_agent", "x": 0, "y": 11, "w": 6, "h": 3},
    {"i": "llm_errors_by_type", "x": 6, "y": 11, "w": 6, "h": 3}
  ],
  "widgets": [
    {
      "id": "tasks_submitted",
      "title": "Tasks Submitted",
      "description": "Total tasks submitted by users",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum",
              "aggregateAttribute": {
                "key": "signozforge_tasks_submitted_total",
                "dataType": "float64",
                "type": "Sum",
                "isMonotonic": true
              },
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    },
    {
      "id": "tasks_completed",
      "title": "Tasks Completed",
      "description": "Successful task completions",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum",
              "aggregateAttribute": {
                "key": "signozforge_tasks_completed_total",
                "dataType": "float64",
                "type": "Sum",
                "isMonotonic": true
              },
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    },
    {
      "id": "tasks_failed",
      "title": "Tasks Failed / Manual",
      "description": "Tasks that ended in error or manual mode",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum",
              "aggregateAttribute": {
                "key": "signozforge_tasks_failed_total",
                "dataType": "float64",
                "type": "Sum",
                "isMonotonic": true
              },
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    },
    {
      "id": "anomalies_detected",
      "title": "Anomalies Detected",
      "description": "Total anomalies caught by the SRE Copilot",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum",
              "aggregateAttribute": {
                "key": "signozforge_copilot_anomalies_detected_total",
                "dataType": "float64",
                "type": "Sum",
                "isMonotonic": true
              },
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    },
    {
      "id": "llm_latency_avg",
      "title": "LLM Avg Latency (ms)",
      "description": "Average LLM call latency over time, by calling agent",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "avg",
              "aggregateAttribute": {
                "key": "signozforge_llm_latency_ms",
                "dataType": "float64",
                "type": "Histogram"
              },
              "groupBy": [{"key": "llm_caller", "dataType": "string", "type": "tag"}],
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    },
    {
      "id": "llm_latency_p95",
      "title": "LLM p95 Latency (ms)",
      "description": "95th percentile LLM latency -- spikes here degrade the whole pipeline",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "p95",
              "aggregateAttribute": {
                "key": "signozforge_llm_latency_ms",
                "dataType": "float64",
                "type": "Histogram"
              },
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    },
    {
      "id": "healing_attempts_vs_success",
      "title": "Copilot: Healing Attempts vs Successes",
      "description": "How often healing is triggered and how often it actually fixes the problem",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum_rate",
              "aggregateAttribute": {
                "key": "signozforge_copilot_healing_attempts_total",
                "dataType": "float64",
                "type": "Sum",
                "isMonotonic": true
              },
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false,
              "legend": "Healing Attempts"
            },
            {
              "queryName": "B",
              "dataSource": "metrics",
              "aggregateOperator": "sum_rate",
              "aggregateAttribute": {
                "key": "signozforge_copilot_healing_successes_total",
                "dataType": "float64",
                "type": "Sum",
                "isMonotonic": true
              },
              "filters": {"items": [], "op": "AND"},
              "expression": "B",
              "disabled": false,
              "legend": "Healing Successes"
            }
          ]
        }
      }
    },
    {
      "id": "manual_mode_triggers",
      "title": "Manual Mode Activations",
      "description": "When the Copilot gives up and escalates to the developer",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum_rate",
              "aggregateAttribute": {
                "key": "signozforge_copilot_manual_mode_triggers_total",
                "dataType": "float64",
                "type": "Sum",
                "isMonotonic": true
              },
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    },
    {
      "id": "agent_step_latency",
      "title": "Agent Step Latency (ms) by Step",
      "description": "How long each agent step takes -- Research, Code, Review",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "traces",
              "aggregateOperator": "avg",
              "aggregateAttribute": {
                "key": "duration_nano",
                "dataType": "float64",
                "type": "tag",
                "isColumn": true
              },
              "groupBy": [{"key": "name", "dataType": "string", "type": "tag", "isColumn": true}],
              "filters": {
                "items": [
                  {
                    "key": {"key": "serviceName", "dataType": "string", "type": "tag", "isColumn": true},
                    "op": "=",
                    "value": "signozforge-observer"
                  },
                  {
                    "key": {"key": "name", "dataType": "string", "type": "tag", "isColumn": true},
                    "op": "LIKE",
                    "value": "agent.%"
                  }
                ],
                "op": "AND"
              },
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    },
    {
      "id": "llm_calls_by_agent",
      "title": "LLM Calls by Agent",
      "description": "Which agent is consuming the most LLM calls",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum_rate",
              "aggregateAttribute": {
                "key": "signozforge_llm_calls_total_total",
                "dataType": "float64",
                "type": "Sum",
                "isMonotonic": true
              },
              "groupBy": [{"key": "llm_caller", "dataType": "string", "type": "tag"}],
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    },
    {
      "id": "llm_errors_by_type",
      "title": "LLM Errors by Type",
      "description": "Breakdown of LLM failures: timeouts, rate limits, HTTP errors",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "metrics",
              "aggregateOperator": "sum_rate",
              "aggregateAttribute": {
                "key": "signozforge_llm_errors_total_total",
                "dataType": "float64",
                "type": "Sum",
                "isMonotonic": true
              },
              "groupBy": [{"key": "llm_error_type", "dataType": "string", "type": "tag"}],
              "filters": {"items": [], "op": "AND"},
              "expression": "A",
              "disabled": false
            }
          ]
        }
      }
    }
  ],
  "variables": {}
}
