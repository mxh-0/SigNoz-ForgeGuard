# SignozForge Observer — Environment Variables
# Copy this to .env and fill in your values

# REQUIRED: Groq API Key (get one at https://console.groq.com)
LLM_API_KEY=your_groq_api_key_here

# Optional: LLM settings (defaults shown)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# Optional: Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Optional: OpenTelemetry (for SigNoz integration)
# Leave empty to disable telemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
